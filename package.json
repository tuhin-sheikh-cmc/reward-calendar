{
  "name": "rewards",
  "version": "1.0.0",
  "description": "API-first rewards service built with TypeScript, Fastify and SOLID principles",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:web && concurrently -k -n api,html,css,js \"npm:dev:api\" \"npm:watch:html\" \"npm:watch:css\" \"npm:watch:js\"",
    "dev:api": "tsx watch src/index.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "npm run build:html && npm run build:css && npm run build:js",
    "build:html": "node scripts/build-html.mjs",
    "build:css": "tailwindcss -i frontend/styles/input.css -o public/assets/tailwind.css --minify",
    "build:js": "esbuild frontend/ts/main.ts frontend/ts/points.ts frontend/ts/person.ts --bundle --outdir=public/assets --minify",
    "watch:html": "node scripts/build-html.mjs --watch",
    "watch:css": "tailwindcss -i frontend/styles/input.css -o public/assets/tailwind.css --watch",
    "watch:js": "esbuild frontend/ts/main.ts frontend/ts/points.ts frontend/ts/person.ts --bundle --outdir=public/assets --sourcemap --watch",
    "start": "node dist/index.js",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "create:user": "tsx src/scripts/create-user.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "check": "npm run typecheck && npm run typecheck:test && npm run typecheck:web && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.2",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.4.0",
    "fastify-type-provider-zod": "^5.1.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true,
    "@parcel/watcher@2.5.1": true
  }
}
